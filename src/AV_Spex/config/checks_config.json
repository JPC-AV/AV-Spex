{
  "outputs": {
    "access_file": false,
    "access_file_trim_color_bars": true,
    "access_file_crop_borders": true,
    "access_file_crop_to_480": true,
    "access_file_exclude_flagged_audio": false,
    "report": false,
    "qctools_ext": "qctools.xml.gz",
    "frame_analysis": {
      "enable_bitplane_check": true,
      "enable_border_detection": true,
      "enable_brng_analysis": true,
      "enable_signalstats": true,
      "border_detection_mode": "simple",
      "simple_border_pixels": 25,
      "sophisticated_threshold": 10,
      "sophisticated_edge_sample_width": 100,
      "sophisticated_sample_frames": 30,
      "sophisticated_padding": 5,
      "sophisticated_viz_time": 150,
      "sophisticated_search_window": 120,
      "auto_retry_borders": true,
      "max_border_retries": 3,
      "brng_duration_limit": 300,
      "brng_skip_color_bars": true,
      "signalstats_start_time": 120,
      "signalstats_duration": 60,
      "signalstats_periods": 3,
      "enable_dropped_sample_detection": true,
      "enable_duplicate_frame_detection": true,
      "duplicate_min_run_length": 2
    }
  },
  "fixity": {
    "check_fixity": false,
    "validate_stream_fixity": false,
    "embed_stream_fixity": true,
    "output_fixity": true,
    "overwrite_stream_fixity": false
  },
  "tools": {
    "exiftool": {
      "check_tool": true,
      "run_tool": true
    },
    "ffprobe": {
      "check_tool": true,
      "run_tool": true
    },
    "mediaconch": {
      "mediaconch_policy": "JPC_FFV1-MKV_Preservation_Policy_20260112.xml",
      "run_mediaconch": true
    },
    "mediainfo": {
      "check_tool": true,
      "run_tool": true
    },
    "mediatrace": {
      "check_tool": true,
      "run_tool": true
    },
    "mkvalidator": {
      "check_tool": false,
      "run_tool": false
    },
    "qctools": {
      "run_tool": false
    },
    "qct_parse": {
      "run_tool": false,
      "barsDetection": true,
      "evaluateBars": true,
      "thumbExport": true,
      "audio_analysis": false,
      "detect_clamped_levels": false,
      "detect_chroma_phase_errors": false,
      "detect_tone_leak": false,
      "tagname": ""
